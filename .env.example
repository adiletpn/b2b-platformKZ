# PostgreSQL (Railway). Реальное значение держим только в .env, в репозиторий не коммитим.
DATABASE_URL=
# Отдельная база для автотестов, чтобы Playwright не затирал демо-данные.
TEST_DATABASE_URL=
# Необязательные: мониторинг ошибок и каталог резервных копий.
MONITORING_DSN=
BACKUP_DIR=
# Необязательные: SMS-провайдер Mobizon (mobizon.kz). Без ключа код входа показывается на экране.
SMS_API_KEY=
# Имя отправителя, согласованное с Mobizon; пусто — общий номер провайдера.
SMS_SENDER=
