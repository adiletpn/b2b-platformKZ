# PostgreSQL (Railway). Реальное значение держим только в .env, в репозиторий не коммитим.
DATABASE_URL=
# Отдельная база для автотестов, чтобы Playwright не затирал демо-данные.
TEST_DATABASE_URL=
# Необязательные: мониторинг ошибок и каталог резервных копий.
MONITORING_DSN=
BACKUP_DIR=
# Необязательные: коды по SMS через Firebase Phone Auth. Без ключа и проекта код показывается
# на экране (мок). Веб-конфиг Firebase публичный; NEXT_PUBLIC_* подставляются при сборке,
# поэтому на Railway их задают до build. Консоль Firebase → Project settings → Your apps → Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Пусто — <projectId>.firebaseapp.com.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
